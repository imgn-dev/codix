{
  "$defs": {
    "FileId": {
      "description": "A file or directory identity: its root-relative path with `/` separators,\nthe case found on disk, and symlinks resolved. The root itself is `\"\"`.",
      "type": "string"
    },
    "SymbolResult": {
      "description": "A symbol in query results.",
      "properties": {
        "column": {
          "description": "1-based column, in Unicode scalar values.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "confidence": {
          "description": "How it was found: `textual` for tier 1 symbols.",
          "type": "string"
        },
        "kind": {
          "description": "Kind from the shared vocabulary.",
          "type": "string"
        },
        "language": {
          "description": "Language of the file.",
          "type": "string"
        },
        "line": {
          "description": "1-based line.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "Simple name.",
          "type": "string"
        },
        "path": {
          "description": "Path relative to the cwd, with `/` separators.",
          "type": "string"
        },
        "qualified_name": {
          "description": "Qualified name within the file.",
          "type": "string"
        },
        "root_path": {
          "$ref": "#/$defs/FileId",
          "description": "Root-relative path."
        },
        "signature": {
          "description": "Declaration without the body, when captured.",
          "type": [
            "string",
            "null"
          ]
        },
        "symbol_id": {
          "description": "Symbol ID, accepted by every command naming a symbol.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "root_path",
        "line",
        "column",
        "symbol_id",
        "kind",
        "name",
        "qualified_name",
        "language",
        "confidence"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What [`DefOp`] answers.",
  "properties": {
    "definition": {
      "$ref": "#/$defs/SymbolResult",
      "description": "The definition."
    },
    "possibly_stale": {
      "description": "See [`FindResponse::possibly_stale`].",
      "type": "boolean"
    }
  },
  "required": [
    "definition",
    "possibly_stale"
  ],
  "title": "DefResponse",
  "type": "object"
}
