{
  "$defs": {
    "MissingProvider": {
      "description": "A provider the project needs and this build lacks, reported once.",
      "properties": {
        "files": {
          "description": "For a language, its files, indexed as text.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "hint": {
          "description": "How to get the provider.",
          "type": "string"
        },
        "invalid": {
          "description": "Why its plugin, installed, cannot be used.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ProviderKind",
          "description": "Provider kind."
        },
        "marker": {
          "description": "For a build system or version control system, the file or directory\nthat shows it is in use, such as `pom.xml`.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Provider name, such as `kotlin`.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "hint"
      ],
      "type": "object"
    },
    "ProviderKind": {
      "description": "The three kinds of provider.",
      "oneOf": [
        {
          "const": "language",
          "description": "A language pack.",
          "type": "string"
        },
        {
          "const": "build",
          "description": "A build system.",
          "type": "string"
        },
        {
          "const": "vcs",
          "description": "A version control system.",
          "type": "string"
        }
      ]
    },
    "ScanReport": {
      "description": "What a scan did.",
      "properties": {
        "deleted": {
          "description": "Files removed from the index.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "errors": {
          "description": "Files that could not be read, as (path, error).",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "indexed": {
          "description": "Files parsed: new, changed, or with a new parser version.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "missing": {
          "description": "Providers the project needs and this build lacks.",
          "items": {
            "$ref": "#/$defs/MissingProvider"
          },
          "type": "array"
        },
        "pending": {
          "description": "Files that kept changing during the scan, left for the next one.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "skipped": {
          "description": "Files left out by the walk, with the reason.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/Skip"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "touched": {
          "description": "Files whose stat changed but not their content.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "unchanged": {
          "description": "Files compared and found unchanged.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "warnings": {
          "description": "What went wrong without stopping the scan, such as a resolver that\nfailed.",
          "items": {
            "$ref": "#/$defs/Warning"
          },
          "type": "array"
        }
      },
      "required": [
        "indexed",
        "touched",
        "deleted",
        "unchanged",
        "pending",
        "skipped",
        "errors",
        "missing",
        "warnings"
      ],
      "type": "object"
    },
    "Skip": {
      "description": "Why a file was left out of the walk.",
      "oneOf": [
        {
          "const": "too_large",
          "description": "Over `index.max_file_size`.",
          "type": "string"
        },
        {
          "const": "link_outside_root",
          "description": "A symlink whose target is outside the project root.",
          "type": "string"
        },
        {
          "const": "non_utf8_name",
          "description": "A name that is not valid UTF-8.",
          "type": "string"
        }
      ]
    },
    "Warning": {
      "description": "Something the user should know about a response that does not stop it,\nsuch as an index on a network filesystem.",
      "properties": {
        "code": {
          "description": "Stable code, such as `network_filesystem`.",
          "type": "string"
        },
        "message": {
          "description": "One line describing the risk.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What `init` did.",
  "properties": {
    "agent_docs": {
      "description": "The workflow guide written, if asked for.",
      "type": [
        "string",
        "null"
      ]
    },
    "created": {
      "description": "Whether `.codix/` was created, rather than found.",
      "type": "boolean"
    },
    "hints": {
      "description": "Suggestions for systems whose ignores live in tracked files; given only\nwhen `.codix/` is created.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "root": {
      "description": "The project root.",
      "type": "string"
    },
    "scan": {
      "$ref": "#/$defs/ScanReport",
      "description": "The first index."
    },
    "vcs": {
      "description": "Version control systems detected.",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "root",
    "created",
    "vcs",
    "hints",
    "scan"
  ],
  "title": "InitResponse",
  "type": "object"
}
