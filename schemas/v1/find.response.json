{
  "$defs": {
    "Alternative": {
      "description": "A close name a fuzzy match did not take.",
      "properties": {
        "distance": {
          "description": "Edits from the query to it, ignoring case.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "The name.",
          "type": "string"
        },
        "symbols": {
          "description": "Its symbols, as `find <name> --exact` gives them.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "distance",
        "symbols"
      ],
      "type": "object"
    },
    "FileId": {
      "description": "A file or directory identity: its root-relative path with `/` separators,\nthe case found on disk, and symlinks resolved. The root itself is `\"\"`.",
      "type": "string"
    },
    "FindNext": {
      "description": "What changes in a [`FindRequest`] for its next page.",
      "properties": {
        "after": {
          "description": "Where the next page starts.",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/MatchMode",
          "description": "The mode that matched, so the next page keeps it; `exact` after a fuzzy\nmatch."
        },
        "query": {
          "description": "The corrected name, after a fuzzy match.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "after",
        "mode"
      ],
      "type": "object"
    },
    "MatchMode": {
      "description": "How a name query matches.",
      "oneOf": [
        {
          "const": "exact",
          "description": "The name equals the query.",
          "type": "string"
        },
        {
          "const": "prefix",
          "description": "The name starts with the query, ignoring case.",
          "type": "string"
        },
        {
          "const": "glob",
          "description": "The qualified name matches a glob (`*`, `?`, `[…]`), case-sensitively.",
          "type": "string"
        },
        {
          "const": "fuzzy",
          "description": "The name is within a few edits of the query, ignoring case.",
          "type": "string"
        }
      ]
    },
    "Paged": {
      "description": "One page of results and the total they were taken from.",
      "properties": {
        "breakdown": {
          "description": "Where the results are, when a first page does not hold them all or\nthey are counted: the places below the directory they share, most\nresults first, at most 8.",
          "items": {
            "$ref": "#/$defs/Place"
          },
          "type": "array"
        },
        "items": {
          "description": "The results in this page.",
          "items": {
            "$ref": "#/$defs/SymbolResult"
          },
          "type": "array"
        },
        "total": {
          "description": "Number of results before paging.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "items",
        "total",
        "breakdown"
      ],
      "type": "object"
    },
    "Place": {
      "description": "A directory or a file holding some of the results.",
      "properties": {
        "count": {
          "description": "Results there.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "description": "Path relative to the cwd, as `--path` takes it.",
          "type": "string"
        },
        "root_path": {
          "description": "Root-relative path.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "root_path",
        "count"
      ],
      "type": "object"
    },
    "SymbolResult": {
      "description": "A symbol in query results.",
      "properties": {
        "column": {
          "description": "1-based column, in Unicode scalar values.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "confidence": {
          "description": "How it was found: `scoped` when the name at a location binds to it\nwithin its file, `textual` when found by name, `low` in or around a\nparse error.",
          "type": "string"
        },
        "kind": {
          "description": "Kind from the shared vocabulary.",
          "type": "string"
        },
        "language": {
          "description": "Language of the file.",
          "type": "string"
        },
        "line": {
          "description": "1-based line.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "Simple name.",
          "type": "string"
        },
        "path": {
          "description": "Path relative to the cwd, with `/` separators.",
          "type": "string"
        },
        "qualified_name": {
          "description": "Qualified name within the file.",
          "type": "string"
        },
        "root_path": {
          "$ref": "#/$defs/FileId",
          "description": "Root-relative path."
        },
        "signature": {
          "description": "Declaration without the body, when captured.",
          "type": [
            "string",
            "null"
          ]
        },
        "symbol_id": {
          "description": "Symbol ID, accepted by every command naming a symbol.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "root_path",
        "line",
        "column",
        "symbol_id",
        "kind",
        "name",
        "qualified_name",
        "language",
        "confidence"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What [`FindOp`] answers.",
  "properties": {
    "alternatives": {
      "description": "The other close names, closest first, when matched by fuzzy.",
      "items": {
        "$ref": "#/$defs/Alternative"
      },
      "type": "array"
    },
    "corrected": {
      "description": "The closest name, taken as the one meant, when matched by fuzzy.",
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "$ref": "#/$defs/MatchMode",
      "description": "The mode that matched, or the last one tried."
    },
    "next": {
      "anyOf": [
        {
          "$ref": "#/$defs/FindNext"
        },
        {
          "type": "null"
        }
      ],
      "description": "The next page, when results remain: the request with these fields\nchanged."
    },
    "possibly_stale": {
      "description": "Whether another process held the write lock, so changed files could\nnot be reindexed first.",
      "type": "boolean"
    },
    "results": {
      "$ref": "#/$defs/Paged",
      "description": "Matching symbols: for a fuzzy match, the symbols of the closest name."
    }
  },
  "required": [
    "mode",
    "results",
    "alternatives",
    "possibly_stale"
  ],
  "title": "FindResponse",
  "type": "object"
}
