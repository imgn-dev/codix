{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for [`RefsOp`].",
  "properties": {
    "here": {
      "default": false,
      "description": "Limit results to the current directory's subtree.",
      "type": "boolean"
    },
    "kind": {
      "default": [],
      "description": "Consider symbols of this kind only; repeatable.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "limit": {
      "default": 50,
      "description": "Maximum number of results.",
      "format": "uint",
      "minimum": 1,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "description": "Number of results to skip.",
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "path": {
      "default": [],
      "description": "Limit results to this subtree; repeatable.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "symbol": {
      "description": "Symbol ID, its path part, `file:line:col`, or a name.",
      "type": "string"
    }
  },
  "required": [
    "symbol"
  ],
  "title": "RefsRequest",
  "type": "object"
}
