{
  "$defs": {
    "Confidence": {
      "description": "How sure codix is that a reference is to the symbol.",
      "oneOf": [
        {
          "const": "scoped",
          "description": "Bound to the symbol by scope.",
          "type": "string"
        },
        {
          "const": "bound",
          "description": "Bound to the symbol by a resolver, across files.",
          "type": "string"
        },
        {
          "const": "textual",
          "description": "Matched by name only.",
          "type": "string"
        }
      ]
    },
    "RefContext": {
      "description": "How a reference uses the symbol.",
      "oneOf": [
        {
          "const": "call",
          "description": "A call.",
          "type": "string"
        },
        {
          "const": "type",
          "description": "A type, as in a declaration or a cast.",
          "type": "string"
        },
        {
          "const": "import",
          "description": "An import.",
          "type": "string"
        },
        {
          "const": "read",
          "description": "A read.",
          "type": "string"
        },
        {
          "const": "write",
          "description": "A write.",
          "type": "string"
        }
      ]
    },
    "Sort": {
      "description": "Another order than the results' own.",
      "oneOf": [
        {
          "const": "count",
          "description": "With `files`, the files with the most results first.",
          "type": "string"
        }
      ]
    },
    "Sources": {
      "description": "Which sources a build system declares.",
      "oneOf": [
        {
          "const": "main",
          "description": "The main sources.",
          "type": "string"
        },
        {
          "const": "test",
          "description": "The test sources.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for [`RefsOp`].",
  "properties": {
    "after": {
      "default": null,
      "description": "Return the results after this place, as a page's `next` gives it.",
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/Confidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Keep the references of this certainty only; the definitions stay."
    },
    "context": {
      "default": [],
      "description": "Keep the references in this context only; repeatable; the definitions stay.",
      "items": {
        "$ref": "#/$defs/RefContext"
      },
      "type": "array"
    },
    "count": {
      "default": false,
      "description": "Return how many results there are, not the results.",
      "type": "boolean"
    },
    "exclude_path": {
      "default": [],
      "description": "Leave out this subtree; repeatable.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "files": {
      "default": false,
      "description": "Return one row per file, with its number of results, paged by file.",
      "type": "boolean"
    },
    "here": {
      "default": false,
      "description": "Limit results to the current directory's subtree.",
      "type": "boolean"
    },
    "kind": {
      "default": [],
      "description": "Consider symbols of this kind only; repeatable.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "limit": {
      "default": 50,
      "description": "Maximum number of results.",
      "format": "uint",
      "minimum": 1,
      "type": "integer"
    },
    "path": {
      "default": [],
      "description": "Limit results to this subtree; repeatable.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "sort": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sort"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "With files, `count` puts the files with the most results first, on one page."
    },
    "sources": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sources"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Keep main or test sources only, as the build systems declare them."
    },
    "symbol": {
      "description": "Symbol ID, its path part, `file:line:col`, or a name.",
      "type": "string"
    }
  },
  "required": [
    "symbol"
  ],
  "title": "RefsRequest",
  "type": "object"
}
