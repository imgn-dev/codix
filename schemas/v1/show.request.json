{
  "$defs": {
    "Sources": {
      "description": "Which sources a build system declares.",
      "oneOf": [
        {
          "const": "main",
          "description": "The main sources.",
          "type": "string"
        },
        {
          "const": "test",
          "description": "The test sources.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for [`ShowOp`].",
  "properties": {
    "context": {
      "default": 0,
      "description": "Lines shown before and after the symbol.",
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "exclude_path": {
      "default": [],
      "description": "Leave out this subtree; repeatable.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "here": {
      "default": false,
      "description": "Limit results to the current directory's subtree.",
      "type": "boolean"
    },
    "kind": {
      "default": [],
      "description": "Consider symbols of this kind only; repeatable.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "limit": {
      "default": 10,
      "description": "Most symbols shown when the name matches several.",
      "format": "uint",
      "minimum": 1,
      "type": "integer"
    },
    "path": {
      "default": [],
      "description": "Limit results to this subtree; repeatable.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "sources": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sources"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Keep main or test sources only, as the build systems declare them."
    },
    "symbol": {
      "description": "Symbol ID, its path part, `file:line:col`, or a name.",
      "type": "string"
    }
  },
  "required": [
    "symbol"
  ],
  "title": "ShowRequest",
  "type": "object"
}
