{
  "$defs": {
    "FileId": {
      "description": "A file or directory identity: its root-relative path with `/` separators,\nthe case found on disk, and symlinks resolved. The root itself is `\"\"`.",
      "type": "string"
    },
    "Renamed": {
      "description": "A symbol ID that codix renamed, followed to the symbol's ID now.",
      "properties": {
        "from": {
          "description": "The ID as given.",
          "type": "string"
        },
        "to": {
          "description": "The ID the symbol has now.",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "Source": {
      "description": "One symbol's source.",
      "properties": {
        "first_line": {
          "description": "1-based number of the first line in `lines`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "lines": {
          "description": "The symbol's lines, with the context asked for.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "symbol": {
          "$ref": "#/$defs/SymbolResult",
          "description": "The symbol."
        }
      },
      "required": [
        "symbol",
        "first_line",
        "lines"
      ],
      "type": "object"
    },
    "SymbolResult": {
      "description": "A symbol in query results.",
      "properties": {
        "column": {
          "description": "1-based column, in Unicode scalar values.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "confidence": {
          "description": "How it was found: `scoped` when the name at a location binds to it\nwithin its file, `textual` when found by name, `low` in or around a\nparse error.",
          "type": "string"
        },
        "kind": {
          "description": "Kind from the shared vocabulary.",
          "type": "string"
        },
        "language": {
          "description": "Language of the file.",
          "type": "string"
        },
        "line": {
          "description": "1-based line.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "Simple name.",
          "type": "string"
        },
        "path": {
          "description": "Path relative to the cwd, with `/` separators.",
          "type": "string"
        },
        "qualified_name": {
          "description": "Qualified name within the file.",
          "type": "string"
        },
        "root_path": {
          "$ref": "#/$defs/FileId",
          "description": "Root-relative path."
        },
        "signature": {
          "description": "Declaration without the body, when captured.",
          "type": [
            "string",
            "null"
          ]
        },
        "symbol_id": {
          "description": "Symbol ID, accepted by every command naming a symbol.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "root_path",
        "line",
        "column",
        "symbol_id",
        "kind",
        "name",
        "qualified_name",
        "language",
        "confidence"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What [`ShowOp`] answers.",
  "properties": {
    "possibly_stale": {
      "description": "See [`FindResponse::possibly_stale`].",
      "type": "boolean"
    },
    "renamed": {
      "anyOf": [
        {
          "$ref": "#/$defs/Renamed"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When the ID given was the symbol's before codix renamed it."
    },
    "sources": {
      "description": "Every symbol the input names, by path and position, at most `limit`.",
      "items": {
        "$ref": "#/$defs/Source"
      },
      "type": "array"
    },
    "total": {
      "description": "How many symbols the input names.",
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "sources",
    "total",
    "possibly_stale"
  ],
  "title": "ShowResponse",
  "type": "object"
}
